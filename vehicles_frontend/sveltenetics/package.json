    "chartjs-plugin-streaming": "^2.0.0",
    "compromise": "^14.14.0",
    "fraction.js": "^4.3.7",
    "generate-license-file": "^3.7.0",
    "html5-qrcode": "^2.3.8",
    "js-sha256": "^0.11.0",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "lucide-svelte": "^0.408.0",
