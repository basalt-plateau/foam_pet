{
  "name": "sveltenetics",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "front": "vite dev --host 0.0.0.0 --port 21000 --clearScreen false",
    "foam-local": "vite dev --port 21000 --clearScreen false",
    "build_forget": "rm -rf /Metro/vehicles/Mech_Pet/sveltnetics_packets",
    "build_refresh_node_modules": "rm -rf node_modules && pnpm install",
    "build_frontend": "pnpm run build_forget && pnpm run build_refresh_node_modules && vite build",
    "rules_build": "pnpm run rules_build_full && pnpm run rules_build_legend",
    "rules_build_full": "generate-license-file",
    "rules_build_full----": ".glf.cjs has the config for this",
    "rules_build_legend": "pnpm licenses list > \"$Rules_Path_FE/frontend_rules_legend.txt\"",
    "health": "node --version && vitest",
    "health----": "if node is not installed, vitest doesn't do anything..",
    "preview": "vite preview",
    "lint": "eslint .",
    "showbiz": "python3 -m http.server 21000 --directory build"
  },
  "devDependencies": {
    "@fontsource/fira-mono": "^4.5.10",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/svelte": "^5.2.6",
    "@types/eslint": "^8.56.7",
    "@unocss/preset-icons": "^0.61.3",
    "@unocss/preset-wind": "^0.61.3",
    "@unocss/reset": "^0.61.3",
    "@unocss/transformer-directives": "^0.61.3",
    "@unocss/transformer-variant-group": "^0.61.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.36.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.1",
    "nlf": "^2.1.1",
    "postcss": "^8.4.38",
    "svelte": "^4.2.7",
    "tailwindcss": "^3.4.4",
    "vite": "^5.0.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^1.33.1",
    "@bothy/trucks": "^2.0.0",
    "@floating-ui/dom": "^1.6.11",
    "@lucide/lab": "^0.1.2",
    "@scure/bip39": "^1.5.4",
    "@skeletonlabs/skeleton": "^2.10.1",
    "@skeletonlabs/tw-plugin": "^0.4.0",
